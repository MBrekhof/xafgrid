<?xml version="1.0" encoding="utf-8"?>
<!-- headed + slow: dotnet test XafGrid.Tests.Playwright --settings XafGrid.Tests.Playwright/.runsettings -->
<RunSettings>
  <Playwright>
    <BrowserName>chromium</BrowserName>
    <LaunchOptions>
      <Headless>false</Headless>
      <SlowMo>250</SlowMo>
    </LaunchOptions>
  </Playwright>
</RunSettings>

<?xml version="1.0" encoding="utf-8"?>
<Application>
  <Options UIType="TabbedMDI"
         FormStyle="Ribbon"
         RestoreTabbedMdiLayout="True"
         ShowTabImage="True"
	 VirtualScrollingEnabled="True">
  </Options>
  <!-- demo ListViews are created in code (DemoViewsGeneratorUpdater); only their navigation items live here -->
  <NavigationItems NavigationStyle="Accordion">
    <Items>
      <Item Id="GridDemos" Caption="Grid Demos" Index="0" IsNewNode="True">
        <Items>
          <Item Id="D1" ViewId="Order_ListView_MasterDetail" Caption="D1 Master-detail row" IsNewNode="True" />
          <Item Id="D2" ViewId="Order_ListView_Cells" Caption="D2 Rich cells" IsNewNode="True" />
          <Item Id="D3" ViewId="Order_ListView_Heatmap" Caption="D3 Heat-map" IsNewNode="True" />
          <Item Id="D4" ViewId="Order_ListView_Groups" Caption="D4 Custom grouping" IsNewNode="True" />
          <Item Id="D5" ViewId="Order_ListView_Summary" Caption="D5 Custom summaries" IsNewNode="True" />
          <Item Id="D6" ViewId="Order_ListView_Toolbar" Caption="D6 In-grid toolbar" IsNewNode="True" />
          <Item Id="D7" ViewId="Order_ListView_Unbound" Caption="D7 Unbound columns" IsNewNode="True" />
          <Item Id="D8" ViewId="Product_ListView_Reorder" Caption="D8 Drag to reorder" IsNewNode="True" />
          <Item Id="D9" ViewId="Order_ListView_Presets" Caption="D9 Layout presets" IsNewNode="True" />
          <Item Id="D10" ViewId="Order_ListView_Columns" Caption="D10 Wide grid" IsNewNode="True" />
        </Items>
      </Item>
    </Items>
  </NavigationItems>
</Application>
